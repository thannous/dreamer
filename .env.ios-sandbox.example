# Copy to ignored .env.ios-sandbox.local; retain the app's existing backend profile.
# Never put passwords or private backend keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_MOCK_MODE=false
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_REPLACE_WITH_EXISTING_PUBLIC_APPLE_SDK_KEY
E2E_IPHONE_DEVICE_NAME=REPLACE_WITH_CONNECTED_IPHONE_NAME
E2E_IPHONE_UDID=REPLACE_WITH_OWNED_IPHONE_UDID
E2E_IPHONE_EXPECTED_APP_USER_ID=REPLACE_WITH_APPROVED_NOCTALIA_USER_UUID
E2E_IPHONE_EXPECTED_VERSION=3.5.0
E2E_IPHONE_EXPECTED_BUILD=13
E2E_IPHONE_EVIDENCE=/absolute/path/to/private/evidence
E2E_IPHONE_METRO_LOG=/absolute/path/to/private/metro.log
E2E_IPHONE_METRO_ORIGIN=http://127.0.0.1:4519
AGENT_DEVICE_IOS_TEAM_ID=REPLACE_WITH_EXISTING_XCODE_TEAM
AGENT_DEVICE_IOS_BUNDLE_ID=REPLACE_WITH_SIGNED_RUNNER_BUNDLE
AGENT_DEVICE_IOS_RUNNER_DERIVED_PATH=/absolute/path/to/existing/runner-derived-data
# Evidence/preflight.json: sandboxAccountConfirmedByOwner=true,
# emailValidationConfirmedByOwner=true, bundle=com.tanuki75.noctalia.
# No password belongs in this profile. Native Apple/Google auth stays on device.
