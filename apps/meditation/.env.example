# Accounts are OFF in v1.0 store builds: the auth screens exist but must stay
# unreachable (App Store 2.1 — never ship a sign-in button that does nothing).
EXPO_PUBLIC_ACCOUNTS_ENABLED=false

# Mock services for E2E and offline development.
EXPO_PUBLIC_MOCK_MODE=false

# RevenueCat (L7).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
