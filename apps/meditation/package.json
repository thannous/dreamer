{
  "name": "noctalia-meditation",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "dependencies:check": "expo install --check",
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_MOCK_MODE=true expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "npm run brand:check && expo lint app components constants context hooks lib services tests",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/smoke.yml",
    "test:e2e:all": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/",
    "test:e2e:onboarding": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/onboarding.yml",
    "test:e2e:playback": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/session-playback.yml",
    "test:e2e:breathing": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/breathing.yml",
    "test:e2e:paywall": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/paywall.yml",
    "test:e2e:settings": "node ../../scripts/android-device-lock.js wrap --owner meditation -- maestro test maestro/settings.yml",
    "brand:check": "node ../../scripts/check-brand-tokens.js --meditation",
    "release:plan": "node ../../scripts/mobile-release.js plan --app meditation",
    "release:prepare": "node ../../scripts/mobile-release.js prepare --app meditation",
    "release:check": "node ../../scripts/mobile-release.js check --app meditation",
    "release:build": "node ../../scripts/mobile-release.js build --app meditation",
    "eas-build-pre-install": "node ../../scripts/mobile-release.js verify --app meditation",
    "test:testerarmy": "node ../../tools/e2e/run.mjs meditation web",
    "test:testerarmy:mobile": "node ../../tools/e2e/run.mjs mobile meditation",
    "agent-device:doctor": "node ../../tools/e2e/node_modules/agent-device/bin/agent-device.mjs doctor",
    "agent-device:inspect": "node ../../tools/e2e/run.mjs inspect meditation",
    "agent-device:mcp": "node ../../tools/e2e/run.mjs mcp meditation",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.13.9",
    "@shopify/react-native-skia": "2.13.1",
    "expo": "~58.0.6",
    "expo-asset": "~58.0.13",
    "expo-audio": "~58.0.7",
    "expo-blur": "~58.0.3",
    "expo-constants": "~58.0.10",
    "expo-file-system": "~58.0.7",
    "expo-font": "~58.0.7",
    "expo-haptics": "~58.0.5",
    "expo-image": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.11",
    "expo-localization": "~58.0.3",
    "expo-notifications": "~58.1.1",
    "expo-router": "~58.0.16",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.6",
    "expo-status-bar": "~58.0.3",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.5",
    "expo-video": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0-rc.3",
    "react-native-gesture-handler": "~3.2.1",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "4.7.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.12.2",
    "expo-build-properties": "~58.0.10"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0-rc.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.8",
    "jest-junit": "^16.0.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "@testing-library/react-native-legacy": "npm:@testing-library/react-native@13.3.3",
    "patch-package": "8.0.1"
  },
  "overrides": {
    "react-native": "$react-native",
    "react-native-worklets": "$react-native-worklets"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
