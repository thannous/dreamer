{
  "name": "noctalia-meditation",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dependencies:check": "expo install --check",
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_MOCK_MODE=true expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "npm run brand:check && expo lint app components constants context hooks lib services tests",
    "typecheck": "tsc --noEmit",
    "brand:check": "node ../../scripts/check-brand-tokens.js --meditation",
    "release:plan": "node ../../scripts/mobile-release.js plan --app meditation",
    "release:prepare": "node ../../scripts/mobile-release.js prepare --app meditation",
    "release:check": "node ../../scripts/mobile-release.js check --app meditation",
    "release:build": "node ../../scripts/mobile-release.js build --app meditation",
    "eas-build-pre-install": "node ../../scripts/mobile-release.js verify --app meditation",
    "test:testerarmy": "node ../../tools/e2e/run.mjs meditation web",
    "test:testerarmy:mobile": "node ../../tools/e2e/run.mjs mobile meditation",
    "agent-device:doctor": "node ../../tools/e2e/node_modules/agent-device/bin/agent-device.mjs doctor",
    "agent-device:inspect": "node ../../tools/e2e/run.mjs inspect meditation",
    "agent-device:mcp": "node ../../tools/e2e/run.mjs mcp meditation",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@expo-google-fonts/fraunces": "^0.4.1",
    "@expo-google-fonts/lora": "^0.4.2",
    "@expo-google-fonts/outfit": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/drawer": "^7.13.9",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.17",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-file-system": "~58.0.10",
    "expo-font": "~58.0.9",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.6",
    "expo-router": "~58.0.25",
    "expo-speech": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "^10.7.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.12.2",
    "expo-build-properties": "~58.0.11"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "^30.2.0",
    "jest-expo": "~58.0.12",
    "jest-junit": "^16.0.0",
    "react-test-renderer": "19.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~6.0.3",
    "@testing-library/react-native-legacy": "npm:@testing-library/react-native@13.3.3",
    "patch-package": "8.0.1",
    "braces": "file:../../tools/braces",
    "image-size": "file:../../tools/image-size-compat"
  },
  "overrides": {
    "react-native": "$react-native",
    "react-native-worklets": "$react-native-worklets",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@humanfs/node": "0.16.8",
    "@xmldom/xmldom": "0.8.15",
    "ajv@>=8 <8.18.0": "8.20.0",
    "baseline-browser-mapping": "2.11.1",
    "brace-expansion@>=1 <2": "1.1.21",
    "brace-expansion@>=2 <3": "2.1.7",
    "brace-expansion@>=4 <6": "5.0.12",
    "browserslist": "4.28.8",
    "fast-uri@>=3 <4": "3.1.8",
    "hono": "4.13.13",
    "ip-address": "10.7.1",
    "js-yaml@>=3 <4": "3.15.2",
    "js-yaml@>=4 <5": "4.3.2",
    "minimatch@>=10 <11": "10.2.6",
    "path-to-regexp@>=6 <7": "6.3.0",
    "path-to-regexp@>=8 <9": "8.4.2",
    "proxy-addr@>=2 <3": "2.0.8",
    "qs@>=6 <7": "6.16.0",
    "smol-toml@>=1 <2": "1.9.0",
    "source-map-js@>=1 <2": "1.2.2",
    "tar@>=7 <8": "7.5.22",
    "undici@>=5 <7": "6.29.0",
    "undici@>=7 <8": "7.30.0",
    "uuid@<11.1.1": "11.1.1",
    "braces": "$braces",
    "image-size": "$image-size"
  },
  "expo": {
    "install": {
      "exclude": [
        "jest",
        "@types/jest"
      ]
    }
  }
}
