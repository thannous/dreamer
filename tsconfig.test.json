{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": [
      "jest",
      "node"
    ]
  },
  "include": [
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**/*.ts",
    "**/__tests__/**/*.tsx",
    "tests/**/*",
    "uniwind-types.d.ts",
    ".expo/types/noctalia-router.d.ts"
  ],
  "exclude": [
    "apps/**",
    "supabase/functions/**",
    ".expo/types/router.d.ts"
  ]
}
