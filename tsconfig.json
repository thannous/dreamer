{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "react",
      "react-native",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "uniwind-types.d.ts",
    "uniwind-env.d.ts"
  ],
  "exclude": [
    "apps/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/__tests__/**",
    "tests/**",
    "maestro/**",
    "supabase/functions/**",
    "coverage/**",
    "dist/**",
    "dist-dev-nossg/**",
    "tools/e2e/**",
    ".expo/types/router.d.ts"
  ]
}
