#!/bin/sh
# Pre-push hook (AGENTS.md, "Livraison").
# It takes a few seconds and runs no suite: forbidden files, secrets and file
# size of what the push sends, then the proof of the pushed tree (a missing
# proof does not block). Run `npm run verify:pr` on the commit before pushing
# it; this hook does not replace it. A branch deletion or a push with no new commit runs
# nothing. `npm ci` / `npm install` install this hook: the `prepare` script
# points core.hooksPath at .githooks (scripts/install-git-hooks.js).
# Never bypass or disable it (`git push --no-verify`, core.hooksPath).

root="$(git rev-parse --show-toplevel)" || exit 1

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node is not on PATH; the push checks did not run and nothing was pushed." >&2
  echo "pre-push: run \`mise install\`, then push through \`mise exec -- git push\` (or activate mise in this shell)." >&2
  exit 1
fi

exec node "$root/scripts/verify-local.mjs" hook "$@"
