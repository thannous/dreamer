{
  "expo": {
    "name": "Noctalia",
    "slug": "noctalia",
    "version": "3.7.1",
    "icon": "./assets/images/icon.png",
    "scheme": "noctalia",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "requireFullScreen": false,
      "bundleIdentifier": "com.tanuki75.noctalia",
      "entitlements": {
        "com.apple.developer.devicecheck.appattest-environment": "development"
      },
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:dream.noctalia.app"
      ],
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow $(PRODUCT_NAME) to use speech recognition.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to use the microphone.",
        "NSCameraUsageDescription": "Noctalia does not use the camera. A picture you give a dream comes from your photo library.",
        "NSPhotoLibraryUsageDescription": "Allow Noctalia to use a photo from your library as the picture of a dream.",
        "NSHealthShareUsageDescription": "When you choose to connect Apple Health in Lucid Trainer, Noctalia reads your past sleep records to show personal trends.",
        "NSHealthUpdateUsageDescription": "Noctalia does not add or change data in Apple Health. Its optional sleep history feature only reads records you choose to connect.",
        "CADisableMinimumFrameDurationOnPhone": true,
        "LSApplicationQueriesSchemes": [
          "mailto",
          "tel"
        ]
      },
      "buildNumber": "14"
    },
    "android": {
      "versionCode": 83,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "dream.noctalia.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "package": "com.tanuki75.noctalia"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "name": "Noctalia Dream Journal | Record and Explore Your Dreams",
      "description": "Keep a dream journal in your browser. Write or record dreams, revisit your entries, and explore possible symbols and emotions with Noctalia.",
      "shortName": "Noctalia",
      "themeColor": "#000000",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#21162b",
          "android": {
            "imageWidth": 180
          },
          "dark": {
            "backgroundColor": "#21162b"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Noctalia to access your microphone to record your dreams.",
          "enableBackgroundPlayback": true
        }
      ],
      "./plugins/withOptionalAndroidHardwareFeatures",
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      "expo-secure-store",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.359653779023-d3ddevr4qepqa13uqlv1ckd0th6k79gf"
        }
      ],
      "expo-localization",
      "expo-notifications",
      "./plugins/withDisableNotificationsBootActions",
      "expo-speech-recognition",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 28,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "packagingOptions": {
              "exclude": [
                "/org/bouncycastle/pqc/crypto/picnic/*.properties"
              ]
            }
          }
        }
      ],
      "./plugins/withAndroidR8Optimization",
      "./plugins/withoutReactNativeImageDecoders",
      "./plugins/withWebpSplashLogo",
      "./plugins/withRevenueCatTestStoreBuild",
      "./plugins/withSoftExceptionLogging",
      "expo-sqlite",
      "react-native-edge-to-edge",
      "expo-image",
      "expo-sharing",
      "expo-apple-authentication",
      "expo-app-intents",
      "./plugins/withAppIntentsLocalizations",
      [
        "./plugins/withWidgetGalleryStrings",
        {
          "de": {
            "Tell my dream": "Traum erzählen",
            "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.": "Erzähl deinen Traum mit einem Tippen, vom Sperrbildschirm oder vom Home-Bildschirm aus.",
            "Last painted dream": "Letzter gemalter Traum",
            "Your latest dream's painting. Tap it to reopen the dream.": "Das Bild deines letzten Traums. Tippe darauf, um den Traum wieder zu öffnen."
          },
          "es": {
            "Tell my dream": "Contar mi sueño",
            "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.": "Cuenta tu sueño con un toque, desde la pantalla de bloqueo o la de inicio.",
            "Last painted dream": "Último sueño pintado",
            "Your latest dream's painting. Tap it to reopen the dream.": "La pintura de tu último sueño. Tócala para volver a abrirlo."
          },
          "fr": {
            "Tell my dream": "Raconter mon rêve",
            "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.": "Raconte ton rêve en un geste, depuis l’écran verrouillé ou l’écran d’accueil.",
            "Last painted dream": "Dernier rêve peint",
            "Your latest dream's painting. Tap it to reopen the dream.": "La peinture de ton dernier rêve. Touche-la pour rouvrir le rêve."
          },
          "it": {
            "Tell my dream": "Racconta il mio sogno",
            "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.": "Racconta il tuo sogno con un tocco, dalla schermata di blocco o dalla schermata Home.",
            "Last painted dream": "Ultimo sogno dipinto",
            "Your latest dream's painting. Tap it to reopen the dream.": "Il dipinto del tuo ultimo sogno. Toccalo per riaprire il sogno."
          },
          "pt": {
            "Tell my dream": "Contar meu sonho",
            "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.": "Conte seu sonho com um toque, da tela bloqueada ou da tela de início.",
            "Last painted dream": "Último sonho pintado",
            "Your latest dream's painting. Tap it to reopen the dream.": "A pintura do seu último sonho. Toque nela para abrir o sonho de novo."
          }
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "DreamCapture",
              "displayName": "Tell my dream",
              "description": "Opens the capture screen in one tap, from the Lock Screen or the Home Screen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryCircular",
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall"
                ],
                "initialLayout": "widgets/DreamCaptureWidget.tsx"
              }
            },
            {
              "name": "LastDream",
              "displayName": "Last painted dream",
              "description": "Your latest dream's painting. Tap it to reopen the dream.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ],
                "contentMarginsDisabled": true,
                "initialLayout": "widgets/LastDreamWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true,
      "inlineModules": {
        "watchedDirectories": [
          "app-intents"
        ]
      }
    },
    "extra": {
