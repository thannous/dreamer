# Local-only Google Play screenshot profile. It uses mock services and a
# connected mock user, so no customer or production data is touched.
EXPO_PUBLIC_MOCK_MODE=true
EXPO_PUBLIC_ASO_SCREENSHOT_MODE=true
EXPO_PUBLIC_REFERENCE_IMAGES_ENABLED=true
EXPO_PUBLIC_SLEEP_SOUNDS_ENABLED=true
EXPO_PUBLIC_SUBSCRIPTION_QA_LAB=true
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=mock_android_key
EXPO_PUBLIC_REVENUECAT_WEB_KEY=mock_web_key
