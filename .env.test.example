# Shared test login (doc_web_interne/docs/test-login.md). Names only.
# Copy to .env.test.local (gitignored) on the owner machines and fill it there.
# Never put these in an EXPO_PUBLIC_* variable, a committed file or a log.
# The guard (npm run test:env:check) refuses the production project
# usuyppgsmmowzizhaoqj and any ref missing from scripts/test-supabase-targets.json.
E2E_SUPABASE_URL=
E2E_SUPABASE_PROJECT_REF=
E2E_SUPABASE_ANON_KEY=
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_ACCOUNT_DOMAIN=
E2E_FREE_PASSWORD=
E2E_PREMIUM_PASSWORD=
